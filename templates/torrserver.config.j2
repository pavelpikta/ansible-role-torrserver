{%- set daemon_options = [] -%}
{%- set _ = daemon_options.append('--port ' + (torrserver_port | default('') | string)) -%}
{%- set ip_addresses = [] -%}
{%- if torrserver_ip is defined and torrserver_ip is not none -%}
{%- if torrserver_ip is string and (torrserver_ip | string | trim) != '' -%}
{%- set ip_addresses = [torrserver_ip | string | trim] -%}
{%- elif torrserver_ip is iterable and torrserver_ip is not mapping -%}
{%- set ip_addresses = torrserver_ip | map('string') | map('trim') | reject('equalto', '') | list -%}
{%- endif -%}
{%- endif -%}
{%- if torrserver_capabilities.ip | default(false) | bool and ip_addresses | length > 0 -%}
{%- if ip_addresses | length > 1 and not (torrserver_capabilities.ip_repeatable | default(false) | bool) -%}
{%- set _ = daemon_options.append('--ip ' + ip_addresses[0]) -%}
{%- else -%}
{%- for ip_address in ip_addresses -%}
{%- set _ = daemon_options.append('--ip ' + ip_address) -%}
{%- endfor -%}
{%- endif -%}
{%- endif -%}
{%- set _ = daemon_options.append('--path ' + (torrserver_install_dir | default('') | string)) -%}
{%- if torrserver_read_only | bool -%}
{%- set _ = daemon_options.append('--rdb') -%}
{%- endif -%}
{%- if torrserver_enable_log | bool -%}
{%- set _ = daemon_options.append('--logpath ' + (torrserver_log_path | default('') | string)) -%}
{%- endif -%}
{%- if torrserver_weblog_path is defined and torrserver_weblog_path is not none and (torrserver_weblog_path | string | trim) != '' -%}
{%- set _ = daemon_options.append('--weblogpath ' + (torrserver_weblog_path | string | trim)) -%}
{%- endif -%}
{%- if torrserver_enable_auth | bool -%}
{%- set _ = daemon_options.append('--httpauth') -%}
{%- endif -%}
{%- if torrserver_capabilities.ssl | default(false) | bool and torrserver_ssl_enable | bool -%}
{%- set _ = daemon_options.append('--ssl') -%}
{%- endif -%}
{%- if torrserver_capabilities.ssl | default(false) | bool and torrserver_ssl_enable | bool and torrserver_ssl_port is defined and torrserver_ssl_port is not none and (torrserver_ssl_port | string | trim) != '' -%}
{%- set _ = daemon_options.append('--sslport ' + (torrserver_ssl_port | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.ssl | default(false) | bool and torrserver_ssl_cert_path is defined and torrserver_ssl_cert_path is not none and (torrserver_ssl_cert_path | string | trim) != '' -%}
{%- set _ = daemon_options.append('--sslcert ' + (torrserver_ssl_cert_path | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.ssl | default(false) | bool and torrserver_ssl_key_path is defined and torrserver_ssl_key_path is not none and (torrserver_ssl_key_path | string | trim) != '' -%}
{%- set _ = daemon_options.append('--sslkey ' + (torrserver_ssl_key_path | string | trim)) -%}
{%- endif -%}
{%- if torrserver_dontkill | bool -%}
{%- set _ = daemon_options.append('--dontkill') -%}
{%- endif -%}
{%- if torrserver_torrents_dir is defined and torrserver_torrents_dir is not none and (torrserver_torrents_dir | string | trim) != '' -%}
{%- set _ = daemon_options.append('--torrentsdir ' + (torrserver_torrents_dir | string | trim)) -%}
{%- endif -%}
{%- if torrserver_torrent_addr is defined and torrserver_torrent_addr is not none and (torrserver_torrent_addr | string | trim) != '' -%}
{%- set _ = daemon_options.append('--torrentaddr ' + (torrserver_torrent_addr | string | trim)) -%}
{%- endif -%}
{%- if torrserver_pubipv4 is defined and torrserver_pubipv4 is not none and (torrserver_pubipv4 | string | trim) != '' -%}
{%- set _ = daemon_options.append('--pubipv4 ' + (torrserver_pubipv4 | string | trim)) -%}
{%- endif -%}
{%- if torrserver_pubipv6 is defined and torrserver_pubipv6 is not none and (torrserver_pubipv6 | string | trim) != '' -%}
{%- set _ = daemon_options.append('--pubipv6 ' + (torrserver_pubipv6 | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.searchwa | default(false) | bool and torrserver_searchwa | bool -%}
{%- set _ = daemon_options.append('--searchwa') -%}
{%- endif -%}
{%- if torrserver_capabilities.max_size | default(false) | bool and torrserver_max_size is defined and torrserver_max_size is not none and (torrserver_max_size | string | trim) != '' -%}
{%- set _ = daemon_options.append('--maxsize ' + (torrserver_max_size | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.tg_token | default(false) | bool and torrserver_tg_token is defined and torrserver_tg_token is not none and (torrserver_tg_token | string | trim) != '' -%}
{%- set _ = daemon_options.append('--tgtoken ' + (torrserver_tg_token | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.fuse_path | default(false) | bool and torrserver_fuse_path is defined and torrserver_fuse_path is not none and (torrserver_fuse_path | string | trim) != '' -%}
{%- set _ = daemon_options.append('--fusepath ' + (torrserver_fuse_path | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.webdav | default(false) | bool and torrserver_webdav | bool -%}
{%- set _ = daemon_options.append('--webdav') -%}
{%- endif -%}
{%- if torrserver_ui | bool -%}
{%- set _ = daemon_options.append('--ui') -%}
{%- endif -%}
{%- if torrserver_capabilities.proxy_url | default(false) | bool and torrserver_proxy_url is defined and torrserver_proxy_url is not none and (torrserver_proxy_url | string | trim) != '' -%}
{%- set _ = daemon_options.append('--proxyurl ' + (torrserver_proxy_url | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.proxy_mode | default(false) | bool and torrserver_proxy_mode is defined and torrserver_proxy_mode is not none and (torrserver_proxy_mode | string | trim) != '' -%}
{%- set _ = daemon_options.append('--proxymode ' + (torrserver_proxy_mode | string | trim)) -%}
{%- endif -%}
{%- if torrserver_capabilities.force_https | default(false) | bool and torrserver_capabilities.ssl | default(false) | bool and torrserver_ssl_enable | bool and torrserver_force_https | bool -%}
{%- set _ = daemon_options.append('--force-https') -%}
{%- endif -%}
DAEMON_OPTIONS="{{ daemon_options | join(' ') }}"
