{%- set merged_settings = torrserver_bittorr_defaults | combine(torrserver_bittorr_settings | default({}), recursive=True) -%}
{%- set ns = namespace(filtered={}) -%}
{%- for key, value in merged_settings.items() -%}
{%- if key not in torrserver_bittorr_feature_versions or (torrserver_version_sortable is version(torrserver_bittorr_feature_versions[key], '>=')) -%}
{%- set _ = ns.filtered.update({key: value}) -%}
{%- endif -%}
{%- endfor -%}
{
  "BitTorr": {
{%- for key, value in ns.filtered | dictsort %}
    "{{ key }}": {{ value | to_json }}{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
